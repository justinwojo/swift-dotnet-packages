<Project Sdk="SwiftBindings.Sdk/0.19.4">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <!-- Required: the generated binding emits a Swift wrapper (SBW_* @_cdecl) that its P/Invokes call; a wrapper build failure must hard-fail rather than silently ship broken APIs. -->
    <SwiftWrapperRequired>true</SwiftWrapperRequired>

    <!-- NuGet package metadata -->
    <PackageId>SwiftBindings.Stripe.Core</PackageId>
    <Version>26.0.0</Version>
    <Description>.NET bindings for the StripeCore Swift library</Description>
    <PackageTags>$(CommonPackageTags);stripe;stripecore;payments</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Package the README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
