<Project Sdk="SwiftBindings.Sdk/0.19.4">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <!-- Not required: this module's binding emits no Swift wrapper that its P/Invokes reference. -->
    <SwiftWrapperRequired>false</SwiftWrapperRequired>

    <!-- NuGet package metadata -->
    <PackageId>SwiftBindings.Stripe</PackageId>
    <Version>26.0.0</Version>
    <Description>.NET bindings for the Stripe Swift library</Description>
    <PackageTags>$(CommonPackageTags);stripe;payments</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Package the README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <SwiftFrameworkDependency Include="../StripeCore/StripeCore.xcframework" PackageId="SwiftBindings.Stripe.Core" PackageVersion="26.9.0.1" />
    <SwiftFrameworkDependency Include="../StripeApplePay/StripeApplePay.xcframework" PackageId="SwiftBindings.Stripe.ApplePay" PackageVersion="26.9.0.1" />
    <SwiftFrameworkDependency Include="../StripePayments/StripePayments.xcframework" PackageId="SwiftBindings.Stripe.Payments" PackageVersion="26.9.0.1" />
    <SwiftFrameworkDependency Include="../StripePaymentsUI/StripePaymentsUI.xcframework" PackageId="SwiftBindings.Stripe.PaymentsUI" PackageVersion="26.9.0.1" />
    <SwiftFrameworkDependency Include="../StripeUICore/StripeUICore.xcframework" PackageId="SwiftBindings.Stripe.UICore" PackageVersion="26.9.0.1" />
    <SwiftFrameworkDependency Include="../StripeIssuing/StripeIssuing.xcframework" PackageId="SwiftBindings.Stripe.Issuing" PackageVersion="26.9.0.1" />
    <SwiftFrameworkDependency Include="../Stripe3DS2/Stripe3DS2.xcframework" PackageId="SwiftBindings.Stripe.ThreeDS2" PackageVersion="26.9.0.1" />
  </ItemGroup>

<!-- BEGIN auto-detected ProjectReference -->
