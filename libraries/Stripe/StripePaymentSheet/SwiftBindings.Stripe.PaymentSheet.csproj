<Project Sdk="SwiftBindings.Sdk/0.20.2">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <!-- Required: the generated binding emits a Swift wrapper (SBW_* @_cdecl) that its P/Invokes call; a wrapper build failure must hard-fail rather than silently ship broken APIs. -->
    <SwiftWrapperRequired>true</SwiftWrapperRequired>

    <!-- NuGet package metadata -->
    <PackageId>SwiftBindings.Stripe.PaymentSheet</PackageId>
    <Version>26.0.0</Version>
    <Description>.NET bindings for the StripePaymentSheet Swift library</Description>
    <PackageTags>$(CommonPackageTags);stripe;payment-sheet;payments;checkout</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Package the README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

<!-- BEGIN auto-detected SwiftFrameworkDependency -->
  <ItemGroup>
    <SwiftFrameworkDependency Include="../StripeApplePay/StripeApplePay.xcframework" PackageId="SwiftBindings.Stripe.ApplePay" PackageVersion="26.11.0" />
    <SwiftFrameworkDependency Include="../StripeCore/StripeCore.xcframework" PackageId="SwiftBindings.Stripe.Core" PackageVersion="26.11.0" />
    <SwiftFrameworkDependency Include="../StripePayments/StripePayments.xcframework" PackageId="SwiftBindings.Stripe.Payments" PackageVersion="26.11.0" />
    <SwiftFrameworkDependency Include="../StripePaymentsUI/StripePaymentsUI.xcframework" PackageId="SwiftBindings.Stripe.PaymentsUI" PackageVersion="26.11.0" />
    <SwiftFrameworkDependency Include="../StripeUICore/StripeUICore.xcframework" PackageId="SwiftBindings.Stripe.UICore" PackageVersion="26.11.0" />
    <SwiftFrameworkDependency Include="../Stripe3DS2/Stripe3DS2.xcframework" PackageId="SwiftBindings.Stripe.ThreeDS2" PackageVersion="26.11.0" />
  </ItemGroup>
  <!-- END auto-detected SwiftFrameworkDependency -->

<!-- The StripeFinancialConnectionsLite ProjectReference in the block below is hand-authored, and it
     will never be re-detected: that framework exports no public Swift API, so it appears in no
     generated C# and the behaviour-derived scan reads zero hits for it (expect it in the "carried
     forward" log line every run). It is still required — StripePaymentSheet carries a hard
     LC_LOAD_DYLIB on it from Stripe 26.7.0, so without the reference the packed nupkg declares no
     dependency on the framework's carrier package and a consumer installing PaymentSheet alone
     fails at dyld. Do not delete it. This note sits OUTSIDE the block because the injector
     regenerates the block wholesale and strips any comment placed within it. -->

<!-- BEGIN auto-detected ProjectReference -->
  <ItemGroup>
    <ProjectReference Include="../Stripe3DS2/SwiftBindings.Stripe.ThreeDS2.csproj" />
    <ProjectReference Include="../StripeApplePay/SwiftBindings.Stripe.ApplePay.csproj" />
    <ProjectReference Include="../StripeCore/SwiftBindings.Stripe.Core.csproj" />
    <ProjectReference Include="../StripeFinancialConnectionsLite/SwiftBindings.Stripe.FinancialConnectionsLite.csproj" />
    <ProjectReference Include="../StripePayments/SwiftBindings.Stripe.Payments.csproj" />
    <ProjectReference Include="../StripePaymentsUI/SwiftBindings.Stripe.PaymentsUI.csproj" />
    <ProjectReference Include="../StripeUICore/SwiftBindings.Stripe.UICore.csproj" />
  </ItemGroup>
  <!-- END auto-detected ProjectReference -->

</Project>
