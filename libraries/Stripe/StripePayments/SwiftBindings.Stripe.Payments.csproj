<Project Sdk="SwiftBindings.Sdk/0.19.1">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <!-- Required: the generated binding emits a Swift wrapper (SBW_* @_cdecl) that its P/Invokes call; a wrapper build failure must hard-fail rather than silently ship broken APIs. -->
    <SwiftWrapperRequired>true</SwiftWrapperRequired>

    <!-- NuGet package metadata -->
    <PackageId>SwiftBindings.Stripe.Payments</PackageId>
    <Version>26.0.0</Version>
    <Description>.NET bindings for the StripePayments Swift library</Description>
    <PackageTags>$(CommonPackageTags);stripe;stripepayments;payments</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Package the README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

<!-- BEGIN auto-detected SwiftFrameworkDependency -->
  <ItemGroup>
    <SwiftFrameworkDependency Include="../StripeCore/StripeCore.xcframework" PackageId="SwiftBindings.Stripe.Core" PackageVersion="26.4.2" />
    <SwiftFrameworkDependency Include="../Stripe3DS2/Stripe3DS2.xcframework" PackageId="SwiftBindings.Stripe.ThreeDS2" PackageVersion="26.4.2" />
  </ItemGroup>
  <!-- END auto-detected SwiftFrameworkDependency -->

<!-- BEGIN auto-detected ProjectReference -->
  <ItemGroup>
    <ProjectReference Include="../Stripe3DS2/SwiftBindings.Stripe.ThreeDS2.csproj" />
    <ProjectReference Include="../StripeCore/SwiftBindings.Stripe.Core.csproj" />
  </ItemGroup>
  <!-- END auto-detected ProjectReference -->

</Project>
