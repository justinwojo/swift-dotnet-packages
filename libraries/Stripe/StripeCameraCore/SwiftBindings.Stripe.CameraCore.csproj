<Project Sdk="SwiftBindings.Sdk/0.20.0">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>

    <!-- NuGet package metadata -->
    <PackageId>SwiftBindings.Stripe.CameraCore</PackageId>
    <Version>26.0.0</Version>
    <Description>[Transitive] Support package for SwiftBindings.Stripe.* — pulled in automatically by sibling Stripe packages that need camera-based scanning support (StripeCardScan, StripeIdentity). Not an entry point; do not install directly. Wraps Stripe's StripeCameraCore.xcframework.</Description>
    <PackageTags>$(CommonPackageTags);stripe;stripecameracore;payments</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Not required: this module's binding emits no Swift wrapper that its P/Invokes reference. -->
    <SwiftWrapperRequired>false</SwiftWrapperRequired>
  </PropertyGroup>

  <!-- Package the README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <SwiftFrameworkDependency Include="../StripeCore/StripeCore.xcframework" PackageId="SwiftBindings.Stripe.Core" PackageVersion="26.9.0.1" />
  </ItemGroup>

<!-- BEGIN auto-detected ProjectReference -->
  <ItemGroup>
    <ProjectReference Include="../StripeCore/SwiftBindings.Stripe.Core.csproj" />
  </ItemGroup>
  <!-- END auto-detected ProjectReference -->

</Project>
