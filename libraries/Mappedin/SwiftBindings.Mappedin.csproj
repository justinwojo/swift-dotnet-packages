<Project Sdk="SwiftBindings.Sdk/11.0.0">

  <PropertyGroup>
    <TargetFramework>$(SwiftBindingsTfmIos)</TargetFramework>

    <!-- NuGet package metadata -->
    <PackageId>SwiftBindings.Mappedin</PackageId>
    <Version>6.2.0</Version>
    <Description>Native Swift interop bindings for the Mappedin indoor mapping library</Description>
    <PackageTags>$(CommonPackageTags);mappedin;indoor-mapping;maps;wayfinding</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Package the README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
