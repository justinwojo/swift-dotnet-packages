<Project Sdk="SwiftBindings.Sdk/0.20.2">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>

    <!-- FBSDKCoreKit_Basics ships as a pure Objective-C framework (no
         .swiftinterface, only a clang module map + umbrella header). Both
         properties must live in the csproj body so the .NET iOS workload's bgen
         pipeline engages at evaluation time — without them the SDK still writes
         ApiDefinition.cs but nothing compiles it and the package ships an
         assembly with zero binding types. -->
    <SwiftFrameworkType>ObjC</SwiftFrameworkType>
    <IsBindingProject>true</IsBindingProject>

    <!-- NuGet package metadata -->
    <PackageId>SwiftBindings.Facebook.CoreBasics</PackageId>
    <Version>18.1.0</Version>
    <Description>.NET bindings for the Facebook iOS SDK FBSDKCoreKit_Basics kernel module</Description>
    <PackageTags>$(CommonPackageTags);facebook;meta;fbsdk;corekit-basics</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Package the README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
