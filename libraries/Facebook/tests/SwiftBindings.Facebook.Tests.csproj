<!--
  Facebook (Meta) iOS SDK binding test app.

  Exercises the ObjC->Swift type bridge across the mixed Facebook modules plus the
  forward Login/Share surface. References the Core/Login/Share binding projects and
  all five native xcframeworks (NativeReference does not propagate through
  ProjectReference, so every framework is listed directly).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">iossimulator-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>com.swiftbindings.facebook.tests</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <IncludeSwiftBindingsRuntimeNative>true</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>

  <!-- KNOWN UPSTREAM DEFECT — this app builds and runs on the SIMULATOR ONLY.

       This is a MIXED-LANE vs PURE-OBJC-LANE collision, not two pure-ObjC assemblies:
       binding-metadata.props shows FBSDKCoreKit_Basics alone has
       _SwiftBindingHasWrapperXCFramework=False (pure ObjC, sidecar only), while
       FBSDKCoreKit and FBSDKShareKit are mixed lane and FBAEMKit and FBSDKLoginKit are
       Swift lane — all four carry a real wrapper xcframework plus its
       buildTransitive/runtimes payload. The collision is therefore between a mixed-lane
       companion assembly (Core) and a pure-ObjC assembly (Basics).

       FBSDKCoreKit's generated ApiDefinition re-declares 13 entries that
       FBSDKCoreKit_Basics also owns, spanning seven distinct NATIVE names —
       one class (FBSDKCrashHandler) and six protocols (FBSDKCrashObserving,
       FBSDKDataPersisting, FBSDKFileDataExtracting, FBSDKFileManaging,
       FBSDKInfoDictionaryProviding, FBSDKNotificationDelivering), each protocol
       contributing both a [Protocol] model type and an I... interface. Only the seven
       native names collide in the registrar, which is why MT4118 reports seven.
       Core emits empty [Protocol] shims; Basics emits the real types. Loading
       both managed assemblies in one app collides in the ObjC registrar:

         * dynamic registrar (simulator Debug, what this app runs on) — the runtime
           logs "Could not register the assembly 'SwiftBindings.Facebook.CoreBasics'
           ... Cannot register two managed types (...) with the same native name
           ('FBSDKCrashHandler')" at startup and SWALLOWS it. The app runs and every
           test below passes, because bgen resolves each type through
           Class.GetHandle against the already-loaded native class.
         * static / managed-static registrar — hard BUILD failure:
           MT4118 -> MT4116 -> MT2431/MT2362 -> IL7000 -> NETSDK1144. managed-static
           is forced for NativeAOT and is the default for non-simulator iOS, so
           BuildTestApp for the Facebook library with the device flag, with or
           without the aot flag, BOTH fail.

       Dropping the CoreBasics ProjectReference below does NOT unblock the device
       leg: SwiftBindings.Facebook.Core itself ProjectReferences CoreBasics (the SDK's
       SWIFTBIND081 assertion requires a managed reference for the CoreBasics
       SwiftFrameworkDependency), so the assembly arrives transitively regardless.
       Consequently EVERY consumer of SwiftBindings.Facebook.Core is device-blocked,
       not just ones that opt into CoreBasics.

       Verified remediation (not applied — it trades a build failure for a packaging
       one): marking the CoreBasics SwiftFrameworkDependency NativeOnly="true" in
       Core/AEM/Login/Share and dropping their CoreBasics ProjectReferences makes
       a device NativeAOT build run clean through to an .ipa. No consumer's generated C#
       references the FBSDKCoreKit_Basics namespace, so nothing fails to compile —
       but the published packages would then no longer declare their dependency on
       SwiftBindings.Facebook.CoreBasics, so a consumer installing only Core would
       be missing FBSDKCoreKit_Basics.framework at runtime. The real fix is upstream:
       stop emitting the duplicate declarations in FBSDKCoreKit. -->

  <ItemGroup>
    <None Include="Info.plist" />
  </ItemGroup>

  <!-- Binding projects (Core is pulled in transitively by Login/Share too).
       CoreBasics and AEM are referenced explicitly so their managed binding
       assemblies are actually loaded into the app and can be exercised — a bare
       <NativeReference> only embeds the native framework, it does not bring the
       C# surface along. -->
  <ItemGroup>
    <ProjectReference Include="../FBSDKCoreKit_Basics/SwiftBindings.Facebook.CoreBasics.csproj" />
    <ProjectReference Include="../FBAEMKit/SwiftBindings.Facebook.AEM.csproj" />
    <ProjectReference Include="../FBSDKCoreKit/SwiftBindings.Facebook.Core.csproj" />
    <ProjectReference Include="../FBSDKLoginKit/SwiftBindings.Facebook.Login.csproj" />
    <ProjectReference Include="../FBSDKShareKit/SwiftBindings.Facebook.Share.csproj" />
  </ItemGroup>

  <!-- Clean-build-robust consumption of the mixed FBSDK bindings.

       Each binding project emits its native-reference + ObjC-companion glue into a
       generated *.ProjectReference.targets, but that file only exists AFTER the
       binding has built. A static <Import Condition="Exists(...)"> of it is
       evaluated at project-load — before the ProjectReference'd binding has produced
       the file — so on a CLEAN build the import silently no-ops and the ObjC
       companion types (FBSDKLocation, FBSDKAccessToken, …) go unreferenced,
       failing the compile with CS0012/CS0103. (A warm rebuild "works" only because
       a prior build left the file on disk.)

       Instead, resolve everything at BUILD time in a target gated on
       ResolveProjectReferences — which builds the sibling bindings first — mirroring
       the SDK's own _ReferenceCrossModuleObjCCompanions. NativeReference and the
       ObjC companion reference do not propagate through ProjectReference, so both are
       injected here explicitly; paths are deterministic and Exists()-guarded at
       execution time (after the siblings build), so a not-built transitive binding
       (AEM) is a harmless no-op. -->
  <ItemGroup>
    <_FacebookBinding Include="FBSDKCoreKit" />
    <_FacebookBinding Include="FBAEMKit" />
    <_FacebookBinding Include="FBSDKLoginKit" />
    <_FacebookBinding Include="FBSDKShareKit" />
  </ItemGroup>

  <Target Name="_InjectFacebookSwiftBindingArtifacts"
          DependsOnTargets="ResolveProjectReferences"
          BeforeTargets="ResolveAssemblyReferences;ResolveNativeReferences">

    <!-- ObjC companion managed assemblies (mixed bindings only: Core, Share).
         Query each binding via the SDK's public GetSwiftObjCCompanionAssembly
         contract — a build-time <MSBuild> call, not an eval-time import — so no
         chicken-and-egg. Non-mixed bindings (Login) return nothing. -->
    <MSBuild Projects="../FBSDKCoreKit/SwiftBindings.Facebook.Core.csproj;../FBSDKLoginKit/SwiftBindings.Facebook.Login.csproj;../FBSDKShareKit/SwiftBindings.Facebook.Share.csproj"
             Targets="GetSwiftObjCCompanionAssembly"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier"
             BuildInParallel="false"
             ContinueOnError="true">
      <Output TaskParameter="TargetOutputs" ItemName="_FacebookObjCCompanion" />
    </MSBuild>
    <ItemGroup Condition="'@(_FacebookObjCCompanion)' != ''">
      <Reference Include="@(_FacebookObjCCompanion->Distinct())">
        <Private>true</Private>
      </Reference>
    </ItemGroup>

    <!-- Native references: each binding's original framework + generated Swift
         wrapper xcframework, plus the NativeAOT trim descriptor (device path). -->
    <ItemGroup>
      <NativeReference Include="../%(_FacebookBinding.Identity)/%(_FacebookBinding.Identity).xcframework"
                       Condition="Exists('../%(_FacebookBinding.Identity)/%(_FacebookBinding.Identity).xcframework')">
        <Kind>Framework</Kind>
      </NativeReference>
      <NativeReference Include="../%(_FacebookBinding.Identity)/obj/$(Configuration)/net10.0-ios/swift-binding/%(_FacebookBinding.Identity)SwiftBindings.xcframework"
                       Condition="Exists('../%(_FacebookBinding.Identity)/obj/$(Configuration)/net10.0-ios/swift-binding/%(_FacebookBinding.Identity)SwiftBindings.xcframework')">
        <Kind>Framework</Kind>
      </NativeReference>
      <TrimmerRootDescriptor Include="../%(_FacebookBinding.Identity)/obj/$(Configuration)/net10.0-ios/swift-binding/ILLink.Descriptors.xml"
                             Condition="'$(PublishAot)' == 'true' AND Exists('../%(_FacebookBinding.Identity)/obj/$(Configuration)/net10.0-ios/swift-binding/ILLink.Descriptors.xml')" />
      <IlcArg Include="--descriptor:$(MSBuildProjectDirectory)/../%(_FacebookBinding.Identity)/obj/$(Configuration)/net10.0-ios/swift-binding/ILLink.Descriptors.xml"
              Condition="'$(PublishAot)' == 'true' AND Exists('../%(_FacebookBinding.Identity)/obj/$(Configuration)/net10.0-ios/swift-binding/ILLink.Descriptors.xml')" />
    </ItemGroup>
  </Target>

  <!-- FBSDKCoreKit_Basics is pure ObjC: no Swift wrapper xcframework and no
       generated ProjectReference.targets, so its native framework is referenced
       directly here (its managed binding assembly comes in via the
       ProjectReference above). -->
  <ItemGroup>
    <NativeReference Include="../FBSDKCoreKit_Basics/FBSDKCoreKit_Basics.xcframework"><Kind>Framework</Kind></NativeReference>
  </ItemGroup>

</Project>
