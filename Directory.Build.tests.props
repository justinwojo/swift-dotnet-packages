<Project>
  <!--
    Shared codesign configuration for test apps (libraries/*/tests/ and
    apple-frameworks/*/tests/). Imported by Directory.Build.props when the
    project name matches *.Tests.

    NativeAOT publish requires codesigning properties. Three ways to provide
    them, in order of precedence:

      1. Env vars at invoke time: CODESIGN_IDENTITY, PROVISIONING_PROFILE, TEAM_ID
         (build/Build.TestApp.cs forwards these as -p: overrides when set)
      2. Local override file: Directory.Build.tests.props.local
         (gitignored — copy the example below and fill in your values)
      3. Per-csproj <CodesignKey> / <CodesignProvision> / <TeamIdentifierPrefix>

    Example Directory.Build.tests.props.local:

      <Project>
        <PropertyGroup>
          <CodesignKey>Apple Development: Your Name (TEAMID)</CodesignKey>
          <CodesignProvision>Wildcard Dev</CodesignProvision>
          <TeamIdentifierPrefix>TEAMID</TeamIdentifierPrefix>
        </PropertyGroup>
      </Project>
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.tests.props.local"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.tests.props.local')" />

  <!-- The SDK excludes the intermediate/output directories from the default
       **/*.cs glob by their PATH ($(BaseIntermediateOutputPath), $(BaseOutputPath)),
       not by their name. A lane that redirects those paths elsewhere — the
       release-consumption lane keeps its package-mode restore out of the tree
       the ProjectReference lanes use — therefore stops excluding the literal
       obj/ and bin/ next to the csproj, and any generated AssemblyInfo.cs left
       there by an ordinary build gets compiled in a second time (CS0579
       duplicate attributes). Excluding them by name as well is a no-op for a
       normal build, where they are already excluded by path. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Desktop test apps build for the host architecture in every configuration.
       The platform SDK picks a desktop app's RID set by configuration: Debug
       gets the host RID, Release (with SupportedOSPlatformVersion below 27)
       gets the universal maccatalyst-x64;maccatalyst-arm64 / osx-x64;osx-arm64
       pair. The harness restores each test csproj once and builds every cell,
       Debug and Release, with no-restore, so a Release desktop build asked for
       an x64 target the assets file never had (NETSDK1047). The validators
       also launch the single-RID bundle. Pinning the host RID here makes
       restore and both configurations agree on one RID set. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' AND '$(RuntimeIdentifiers)' == '' AND ($(TargetFramework.Contains('-maccatalyst')) OR $(TargetFramework.Contains('-macos')))">
    <_SwiftBindingsTestHostArch Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</_SwiftBindingsTestHostArch>
    <_SwiftBindingsTestHostArch Condition="'$(_SwiftBindingsTestHostArch)' == ''">x64</_SwiftBindingsTestHostArch>
    <RuntimeIdentifier Condition="$(TargetFramework.Contains('-maccatalyst'))">maccatalyst-$(_SwiftBindingsTestHostArch)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$(TargetFramework.Contains('-macos'))">osx-$(_SwiftBindingsTestHostArch)</RuntimeIdentifier>
  </PropertyGroup>

  <!-- tvOS test apps: Apple disallows JIT on any tvOS target, so the default
       Debug pipeline AOT-compiles managed code, which surfaces the Swift
       stdlib P/Invokes (Swift.Array.init, Swift.Dictionary.*, …) declared in
       Swift.Runtime as undefined externs at the native link step. The Mono
       interpreter is permitted on tvOS and resolves P/Invokes lazily, same
       as the iOS sim Mono JIT path. Mirrors the workaround already in
       BindingTests/RuntimeTestsApp.tvOS.csproj. .NET 10 only: a .NET 11 tvOS app
       runs CoreCLR (the interpreter in Debug), and the SDK's own tvOS lanes
       likewise apply this Mono workaround to net10 alone. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('tvos')) AND $(TargetFramework.StartsWith('net10.0'))">
    <MtouchLink>None</MtouchLink>
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>
</Project>
