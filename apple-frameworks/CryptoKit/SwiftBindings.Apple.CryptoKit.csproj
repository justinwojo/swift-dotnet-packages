<Project Sdk="SwiftBindings.Sdk/11.0.0">
  <PropertyGroup>
    <!-- Override single-TFM default from Directory.Build.props -->
    <TargetFramework />
    <TargetFrameworks>$(SwiftBindingsTfmIos);$(SwiftBindingsTfmMacos);$(SwiftBindingsTfmMaccatalyst);$(SwiftBindingsTfmTvos)</TargetFrameworks>
    <PackageId>SwiftBindings.Apple.CryptoKit</PackageId>
    <Version>26.2.14</Version>
    <Description>Native Swift interop bindings for Apple CryptoKit</Description>
    <PackageTags>$(CommonPackageTags);macos;tvos;maccatalyst;cryptokit;cryptography;encryption</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <SwiftAppleFrameworkTarget Include="CryptoKit" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
