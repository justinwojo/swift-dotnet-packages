<Project Sdk="SwiftBindings.Sdk/11.0.0">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(SwiftBindingsTfmIos);$(SwiftBindingsTfmMacos);$(SwiftBindingsTfmMaccatalyst);$(SwiftBindingsTfmTvos)</TargetFrameworks>
    <PackageId>SwiftBindings.Apple.AppIntents</PackageId>
    <Version>26.2.14</Version>
    <Description>Native Swift interop bindings for Apple AppIntents</Description>
    <PackageTags>$(CommonPackageTags);macos;tvos;maccatalyst;appintents;siri;shortcuts</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <SwiftAppleFrameworkTarget Include="AppIntents" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
