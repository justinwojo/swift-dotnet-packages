<Project Sdk="SwiftBindings.Sdk/0.19.4">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0-ios26.2;net10.0-maccatalyst26.2;net10.0-macos26.2</TargetFrameworks>
    <PackageId>SwiftBindings.Apple.VisionKit</PackageId>
    <Version>26.2.14</Version>
    <Description>Native Swift interop bindings for Apple VisionKit</Description>
    <PackageTags>$(CommonPackageTags);macos;maccatalyst;visionkit;live-text;image-analysis;data-scanner</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <SwiftAppleFrameworkTarget Include="VisionKit" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
