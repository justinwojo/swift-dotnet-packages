<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework />
    <TargetFrameworks>net10.0-ios;net10.0-maccatalyst;net10.0-macos</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>com.swiftbindings.visionkit.tests</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-macos'))">26.0</SupportedOSPlatformVersion>
    <IncludeSwiftBindingsRuntimeNative Condition="$(TargetFramework.Contains('-ios'))">true</IncludeSwiftBindingsRuntimeNative>
    <!-- macOS console apps don't need provisioning -->
    <CodesignProvision Condition="$(TargetFramework.Contains('-macos'))"></CodesignProvision>
  </PropertyGroup>

  <!-- iOS and MacCatalyst are UIKit app targets — they need an Info.plist. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-ios')) or $(TargetFramework.Contains('-maccatalyst'))">
    <None Include="Info.plist" />
  </ItemGroup>

  <!-- ProjectReference, not PackageReference — a PR changing the sibling csproj
       must be validated against the local change, not a nuget.org version.
       Consuming the packed nupkg instead is the release-consumption lane's job
       (`nuke ReleaseConsume`), which rewrites this reference for every library
       through the repo-root Directory.Build.targets hook. This csproj carried a
       hand-written $(VisionKitPackageVersion) switch for that before the lane
       existed; it was removed so VisionKit is not the one library whose
       consumption path differs from every other library's. -->
  <ItemGroup>
    <ProjectReference Include="../SwiftBindings.Apple.VisionKit.csproj" />
  </ItemGroup>

</Project>
