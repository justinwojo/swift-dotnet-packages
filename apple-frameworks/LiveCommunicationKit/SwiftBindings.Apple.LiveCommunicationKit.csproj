<Project Sdk="SwiftBindings.Sdk/11.0.0">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(SwiftBindingsTfmIos);$(SwiftBindingsTfmMacos);$(SwiftBindingsTfmMaccatalyst)</TargetFrameworks>
    <PackageId>SwiftBindings.Apple.LiveCommunicationKit</PackageId>
    <Version>26.2.14</Version>
    <Description>Native Swift interop bindings for Apple LiveCommunicationKit</Description>
    <PackageTags>$(CommonPackageTags);macos;maccatalyst;livecommunicationkit;voip;calls</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <SwiftAppleFrameworkTarget Include="LiveCommunicationKit" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
