<Project Sdk="SwiftBindings.Sdk/11.0.0">
  <PropertyGroup>
    <!-- Override single-TFM default from Directory.Build.props -->
    <TargetFramework />
    <TargetFrameworks>$(SwiftBindingsTfmIos)</TargetFrameworks>
    <PackageId>SwiftBindings.Apple.RealityFoundation</PackageId>
    <Version>26.2.14</Version>
    <Description>Native Swift interop bindings for Apple RealityFoundation</Description>
    <PackageTags>$(CommonPackageTags);realityfoundation;realitykit;ar;3d</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <SwiftAppleFrameworkTarget Include="RealityFoundation" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
