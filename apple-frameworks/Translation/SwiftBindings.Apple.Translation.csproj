<Project Sdk="SwiftBindings.Sdk/11.0.0">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(SwiftBindingsTfmIos)</TargetFrameworks>
    <PackageId>SwiftBindings.Apple.Translation</PackageId>
    <Version>26.2.14</Version>
    <Description>Native Swift interop bindings for Apple Translation</Description>
    <PackageTags>$(CommonPackageTags);translation;localization;language</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <SwiftAppleFrameworkTarget Include="Translation" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
