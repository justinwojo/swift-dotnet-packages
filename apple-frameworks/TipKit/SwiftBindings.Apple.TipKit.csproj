<Project Sdk="SwiftBindings.Sdk/11.0.0">
  <PropertyGroup>
    <!-- Override single-TFM default from Directory.Build.props -->
    <TargetFramework />
    <TargetFrameworks>$(SwiftBindingsTfmIos);$(SwiftBindingsTfmMacos);$(SwiftBindingsTfmMaccatalyst);$(SwiftBindingsTfmTvos)</TargetFrameworks>
    <PackageId>SwiftBindings.Apple.TipKit</PackageId>
    <Version>26.2.14</Version>
    <Description>Native Swift interop bindings for Apple TipKit</Description>
    <PackageTags>$(CommonPackageTags);macos;tvos;maccatalyst;tipkit;tips;onboarding</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <SwiftAppleFrameworkTarget Include="TipKit" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
