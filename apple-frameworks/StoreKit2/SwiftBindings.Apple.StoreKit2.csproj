<Project Sdk="SwiftBindings.Sdk/11.0.0">
  <PropertyGroup>
    <!-- Override single-TFM default from Directory.Build.props -->
    <TargetFramework />
    <TargetFrameworks>$(SwiftBindingsTfmIos);$(SwiftBindingsTfmMacos);$(SwiftBindingsTfmMaccatalyst);$(SwiftBindingsTfmTvos)</TargetFrameworks>
    <PackageId>SwiftBindings.Apple.StoreKit2</PackageId>
    <Version>26.2.14</Version>
    <Description>Native Swift interop bindings for Apple StoreKit 2</Description>
    <PackageTags>$(CommonPackageTags);macos;tvos;maccatalyst;storekit;in-app-purchase;subscriptions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use StoreKit2 namespace to avoid collision with Microsoft's StoreKit types -->
    <SwiftAppleFrameworkTarget Include="StoreKit" NamespacePattern="StoreKit2" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
