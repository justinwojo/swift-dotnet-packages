<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>com.swiftbindings.realitykit.tests</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <IncludeSwiftBindingsRuntimeNative>true</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Info.plist" />
  </ItemGroup>

  <!-- ProjectReference, not PackageReference — a PR changing the sibling csproj
       must be validated against the local change, not a nuget.org version.
       RealityKit also references the sibling RealityFoundation library directly
       so the cross-module re-export edge is exercised by ProjectReference too. -->
  <ItemGroup>
    <ProjectReference Include="../SwiftBindings.Apple.RealityKit.csproj" />
    <ProjectReference Include="../../RealityFoundation/SwiftBindings.Apple.RealityFoundation.csproj" />
  </ItemGroup>

  <!-- RealityKit PackageReferences RealityFoundation, and this app ProjectReferences it too.
       A staged 26.2.15 nupkg makes both copies import (CS1704). Keep the project output. -->
  <Target Name="_DetectRealityFoundationProjectReference">
    <PropertyGroup>
      <_HasRealityFoundationProjectReference Condition="'%(ProjectReference.Filename)' == 'SwiftBindings.Apple.RealityFoundation'">true</_HasRealityFoundationProjectReference>
    </PropertyGroup>
  </Target>
  <Target Name="_DropStagedRealityFoundationPackageReference" BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="_DetectRealityFoundationProjectReference">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Reference.NuGetPackageId)' == 'SwiftBindings.Apple.RealityFoundation' and '$(_HasRealityFoundationProjectReference)' == 'true'" />
    </ItemGroup>
  </Target>

</Project>
