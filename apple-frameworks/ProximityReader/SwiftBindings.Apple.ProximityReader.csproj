<Project Sdk="SwiftBindings.Sdk/11.0.0">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(SwiftBindingsTfmIos);$(SwiftBindingsTfmMaccatalyst)</TargetFrameworks>
    <PackageId>SwiftBindings.Apple.ProximityReader</PackageId>
    <Version>26.2.14</Version>
    <Description>Native Swift interop bindings for Apple ProximityReader</Description>
    <PackageTags>$(CommonPackageTags);maccatalyst;proximityreader;tap-to-pay;payments</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <SwiftAppleFrameworkTarget Include="ProximityReader" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
